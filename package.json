{
  "name": "dementia-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode offline",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "playwright test",
    "build:offline": "vite build --mode offline",
    "package": "npm run build && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
